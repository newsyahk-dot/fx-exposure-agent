# Copy to .env.local (git-ignored) and fill in. Never commit real values.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
FXA_ANTHROPIC_API_KEY=
# FXA_AGENT_MODEL=claude-haiku-5-5
# FXA_DEFAULT_BASE=USD
# DEMO_MODE=1

# Vercel Cron calls /api/autopilot with this as a bearer token. Without it the route refuses every call.
CRON_SECRET=

# Hosted demo: anything that writes to the sandbox or calls the model on demand needs this code
# (given to judges in the Devpost testing instructions). Unset = open (local development).
FXA_ACCESS_CODE=
